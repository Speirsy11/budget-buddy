{
  "name": "ai-finance-platform",
  "private": true,
  "pnpm": {
    "overrides": {
      "react": "18.3.1",
      "react-dom": "18.3.1",
      "@types/react": "~18.3.12",
      "@types/react-dom": "~18.3.0",
      "@babel/plugin-transform-modules-systemjs": "7.29.4",
      "@babel/core": "7.29.6",
      "@xmldom/xmldom": "0.8.13",
      "ajv@8": "8.18.0",
      "axios": "1.16.0",
      "bn.js": "5.2.3",
      "brace-expansion@1": "1.1.13",
      "fast-uri": "3.1.2",
      "form-data": "4.0.6",
      "js-yaml": "4.2.0",
      "jsondiffpatch": "0.7.2",
      "lodash": "4.18.1",
      "minimatch@3": "3.1.4",
      "minimatch@9": "9.0.7",
      "node-forge": "1.4.0",
      "picomatch@2": "2.3.2",
      "picomatch@3": "3.0.2",
      "picomatch@4": "4.0.4",
      "postcss": "8.5.10",
      "prismjs": "1.30.0",
      "qs": "6.15.2",
      "shell-quote": "1.8.4",
      "tar": "7.5.16",
      "undici": "6.27.0",
      "uuid": "11.1.1",
      "ws@6": "6.2.4",
      "ws@7": "7.5.11",
      "ws@8": "8.21.0",
      "yaml": "1.10.3"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=./apps/web",
    "dev:marketing": "turbo run dev --filter=./apps/marketing",
    "dev:mobile": "turbo run dev --filter=@finance/mobile",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "typecheck": "turbo run typecheck",
    "test": "vitest",
    "test:run": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "db:generate": "turbo run db:generate --filter=@finance/db",
    "db:push": "turbo run db:push --filter=@finance/db",
    "db:studio": "turbo run db:studio --filter=@finance/db",
    "db:migrate": "turbo run db:migrate --filter=@finance/db",
    "infra:up": "./scripts/infra-up.sh",
    "infra:down": "./scripts/infra-down.sh",
    "infra:debug": "./scripts/infra-debug.sh"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@playwright/test": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-react": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-security": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/compositions/*",
    "packages/shared/*",
    "packages/features/*"
  ]
}
