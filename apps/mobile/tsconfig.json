{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "@finance/transactions/csv-parser": [
        "../../packages/features/transactions/src/csv-parser.ts"
      ]
