# Clerk Authentication
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# API Configuration
# iOS simulator can use localhost. Physical devices need your Mac's LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Local simulator-only auth bypass. This is additionally gated by __DEV__ in code.
# Do not set this in preview or production builds.
# EXPO_PUBLIC_LOCAL_SIMULATOR_BYPASS_AUTH=1
