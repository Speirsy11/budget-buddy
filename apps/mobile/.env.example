# Clerk Authentication
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# API Configuration
# iOS simulator can use localhost. Physical devices need your Mac's LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Optional web app URL used for mobile handoff links such as CSV import.
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# Development-only mock auth mode for simulator UI work without Clerk credentials.
# This is additionally gated by __DEV__ and blocked in preview/production builds.
# EXPO_PUBLIC_AUTH_MODE=mock
